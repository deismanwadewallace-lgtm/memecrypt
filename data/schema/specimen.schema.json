{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memecrypt.madethis.app/schema/specimen.schema.json",
  "title": "Memeography specimen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accession",
    "register_id",
    "common_name",
    "binomial",
    "first_outbreak",
    "peak",
    "status",
    "undead_rating",
    "habitat",
    "diet",
    "predators",
    "transmission",
    "cause_of_death",
    "resurrection",
    "host_population",
    "mutation",
    "prognosis",
    "display_tier",
    "display_decision",
    "rights_holder",
    "evidence_grade",
    "image_mode",
    "attribution",
    "commentary",
    "sources",
    "identifiable_person",
    "minor_in_image",
    "merch_posture",
    "underlying_work",
    "enforcement_history",
    "curatorial_note"
  ],
  "properties": {
    "accession": { "type": ["string", "null"] },
    "register_id": { "type": "string", "pattern": "^M[0-9]{2}$" },
    "common_name": { "type": "string", "minLength": 1 },
    "binomial": { "type": ["string", "null"] },
    "first_outbreak": { "type": ["integer", "null"] },
    "peak": { "type": ["string", "integer", "null"] },
    "status": { "type": ["string", "null"] },
    "undead_rating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "habitat": { "type": ["string", "array", "null"] },
    "diet": { "type": ["string", "array", "null"] },
    "predators": { "type": ["string", "array", "null"] },
    "transmission": { "type": ["string", "array", "null"] },
    "cause_of_death": { "type": ["string", "null"] },
    "resurrection": { "type": ["string", "null"] },
    "host_population": { "type": ["string", "null"] },
    "mutation": { "type": ["string", "array", "null"] },
    "prognosis": { "type": ["string", "null"] },
    "display_tier": { "enum": ["D1", "D2", "D3"] },
    "display_decision": {
      "enum": ["declined", "cleared", "unavailable"],
      "description": "What the museum does, as distinct from what the rights position permits. Default for D1 and D2 is declined. D3 is always unavailable. Moving to cleared requires an ADR. See docs/decisions/0003-decline-to-display.md."
    },
    "rights_holder": { "type": ["string", "null"] },
    "evidence_grade": { "type": ["string", "null"] },
    "image_mode": { "enum": ["original_plate", "placeholder", "licensed", null] },
    "attribution": { "type": ["string", "null"] },
    "commentary": { "type": ["string", "null"] },
    "sources": { "type": "array", "items": { "type": "string" } },
    "identifiable_person": { "type": ["string", "null"] },
    "minor_in_image": { "type": ["string", "null"] },
    "merch_posture": { "type": ["string", "null"] },
    "underlying_work": { "type": ["string", "null"] },
    "enforcement_history": { "type": ["string", "null"] },
    "curatorial_note": { "type": ["string", "null"] }
  }
}
